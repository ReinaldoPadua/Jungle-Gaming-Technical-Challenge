NODE_ENV=test
PORT=3000
LOG_LEVEL=warn
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
WAGER_QUEUE_NAME=wager-transactions-test.fifo
WAGER_DLQ_NAME=wager-transactions-dlq-test.fifo
EVENTS_QUEUE_NAME=wallet-events-test.fifo

OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_POLL_INTERVAL_MS=200

CONSUMER_ENABLED=false
CONSUMER_VISIBILITY_TIMEOUT_S=3
CONSUMER_WAIT_TIME_S=1
CONSUMER_MAX_RECEIVES=5
CONSUMER_RETRY_BASE_S=0.2
CONSUMER_RETRY_MAX_S=1
CONSUMER_SHUTDOWN_GRACE_MS=5000

PENDING_WORKER_ENABLED=false
